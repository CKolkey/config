# Config generated by Ghostty Config

clipboard-read = allow
clipboard-write = allow

window-colorspace = display-p3
window-save-state = always

cursor-style = bar

font-thicken = true
font-feature = -calt, -liga, -dlig
font-family = Operator Mono Book
font-family-bold = Operator Mono Medium
font-family-italic = Operator Mono Book Italic
font-family-bold-italic = Operator Mono Medium Italic

font-codepoint-map = U+E000-U+FFFF=Hack Nerd Font Mono Regular
font-codepoint-map = U+EA60-U+EBF8=codicon Regular
font-codepoint-map = U+f101-U+f114,U+f116-U+f25c=nonicons

adjust-cell-height = 40%

macos-titlebar-style = hidden
macos-option-as-alt = true

theme = Atom One Dark
